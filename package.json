    {
      "name": "cutMode",
      "title": "Cut",
      "description": "Partial cuts keep tickets hanging in a chain; full cuts drop each one.",
      "type": "dropdown",
      "required": false,
      "default": "partial",
      "data": [
        {
          "title": "Partial",
          "value": "partial"
        },
        {
          "title": "Full",
          "value": "full"
        },
        {
          "title": "None (tear by hand)",
          "value": "none"
        }
      ]
    },
    {
      "name": "dateOrder",
      "title": "Numeric Dates",
      "description": "How to read dates written as numbers, like 10/9.",
      "type": "dropdown",
      "required": false,
      "default": "month-first",
      "data": [
        {
          "title": "Month/Day (9/30)",
          "value": "month-first"
        },
        {
          "title": "Day/Month (30/9)",
          "value": "day-first"
        }
      ]
    },
    {
      "name": "label",
      "title": "Label",
      "description": "Optional name printed at the top of lists and memos.",
      "type": "textfield",
      "required": false,
      "placeholder": "MY DESK"
    }
  ],
  "dependencies": {
    "@point-of-sale/codepage-encoder": "^3.0.2",
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "@point-of-sale/receipt-printer-renderer": "^1.1.0",
    "@raycast/api": "^2.4.1",
    "@raycast/utils": "^2.3.1",
    "chrono-node": "^2.10.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.19.17",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.5.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "render": "tsx scripts/render.ts",
    "fake-printer": "tsx tests/harness/fake-printer.ts",
    "gen-models": "tsx scripts/gen-models.ts",
    "publish": "npx @raycast/api@latest publish",
    "print-sample": "tsx scripts/print-sample.ts",
    "counters": "tsx scripts/counters.ts",
    "print-image": "tsx scripts/print-image.ts"
  }
}
