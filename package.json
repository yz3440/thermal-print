{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "thermal-print",
  "title": "Thermal Print",
  "description": "Build to-do lists from the search bar, with due dates in plain English, and print them on a thermal receipt printer.",
  "icon": "icon.png",
  "author": "yz3440",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "todo-list",
      "title": "To-Do List",
      "subtitle": "Thermal Print",
      "description": "Type tasks with dates like “call dentist tomorrow 3pm”, then print the whole list as one receipt.",
      "mode": "view",
      "keywords": [
        "tasks",
        "todo",
        "due",
        "print",
        "list"
      ]
    },
    {
      "name": "add-todo",
      "title": "Add To-Do",
      "subtitle": "Thermal Print",
      "description": "Add a task to your to-do list without opening it. Dates like “friday 3pm” are understood; start or end with @list for another list.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Task, e.g. call dentist tomorrow 3pm",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "print-todos",
      "title": "Print To-Do List",
      "subtitle": "Thermal Print",
      "description": "Print your to-do list, grouped by day, as one receipt.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "list",
          "placeholder": "List (optional)",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "name": "compose-receipt",
      "title": "Compose Receipt",
      "subtitle": "Thermal Print",
      "description": "Write a memo or checklist, preview it, then print it.",
      "mode": "view",
      "keywords": [
        "write",
        "memo",
        "checklist",
        "note"
      ]
    },
    {
      "name": "print-image",
      "title": "Print Image",
      "subtitle": "Thermal Print",
      "description": "Print photos, screenshots or any image file, dithered for thermal paper.",
      "mode": "view",
      "keywords": [
        "photo",
        "picture",
        "screenshot",
        "png",
        "jpeg",
        "heic"
      ]
    },
    {
      "name": "print-selection",
      "title": "Print Selection or Clipboard",
      "subtitle": "Thermal Print",
      "description": "Print the selected text or images, or what's on the clipboard. Works with Raycast Notes, Finder and screenshots.",
      "mode": "no-view",
      "keywords": [
        "notes",
        "clipboard",
        "selected",
        "finder",
        "screenshot"
      ]
    },
    {
      "name": "receipt-library",
      "title": "Receipt Library",
      "subtitle": "Thermal Print",
      "description": "Your lists, drafts, pending jobs and print history.",
      "mode": "view",
      "keywords": [
        "lists",
        "drafts",
        "history",
        "pending"
      ]
    },
    {
      "name": "printer-status",
      "title": "Printer Status",
      "subtitle": "Thermal Print",
      "description": "Check the printer's connection, paper and cover, and print a test page.",
      "mode": "view",
      "keywords": [
        "test",
        "paper",
        "diagnostics"
      ]
    }
  ],
  "preferences": [
    {
      "name": "printerAddress",
      "title": "Printer Address",
      "description": "IP address or hostname of the printer, optionally followed by :port (default 9100).",
      "type": "textfield",
      "required": true,
      "placeholder": "192.168.1.3"
    },
    {
      "name": "printerModel",
      "title": "Printer Model",
      "description": "Auto-detect asks Epson printers for their model name. Pick a preset if detection fails or you use another brand.",
